<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.mapper.BookMapper">

    <!-- BookResponseDto.from() 이 book.getUser().getNickname(), book.getStock().getStockQuantity()
         를 참조하므로, AppUser/BookStock 을 LEFT JOIN 해서 함께 채웁니다. -->
    <resultMap id="BookResultMap" type="Book">
        <id     property="id"          column="BOOK_ID"/>
        <result property="title"       column="TITLE"/>
        <result property="author"      column="AUTHOR"/>
        <result property="publisher"   column="PUBLISHER"/>
        <result property="publishDate" column="PUBLISH_DATE"/>
        <result property="category"    column="CATEGORY"/>
        <result property="ranking"     column="RANKING"/>
        <result property="reviewCount" column="REVIEW_COUNT"/>
        <result property="rating"      column="RATING"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="pages"       column="PAGES"/>
        <result property="price"       column="PRICE"/>
        <result property="regDate"     column="REG_DATE"/>
        <result property="bookCover"   column="BOOK_COVER"/>
        <result property="deleted"     column="DELETED"/>
        <association property="user" javaType="AppUser">
            <id     property="id"       column="U_APP_USER_ID"/>
            <result property="nickname" column="U_NICKNAME"/>
        </association>
        <association property="stock" javaType="BookStock">
            <id     property="bookId"        column="BOOK_ID"/>
            <result property="stockQuantity" column="S_STOCK_QUANTITY"/>
        </association>
    </resultMap>

    <sql id="bookJoinColumns">
        b.*, u.APP_USER_ID AS U_APP_USER_ID, u.NICKNAME AS U_NICKNAME,
        s.STOCK_QUANTITY AS S_STOCK_QUANTITY
    </sql>

    <sql id="bookJoinFrom">
        FROM BOOK b
        LEFT JOIN APP_USER u ON b.APP_USER_ID = u.APP_USER_ID
        LEFT JOIN BOOK_STOCK s ON b.BOOK_ID = s.BOOK_ID
    </sql>

    <!-- ==================== 조회 (공개 목록/검색 - 소프트 삭제된 도서는 제외) ==================== -->

    <select id="findAll" parameterType="java.util.Map" resultMap="BookResultMap">
        SELECT <include refid="bookJoinColumns"/>
        <include refid="bookJoinFrom"/>
        WHERE b.DELETED = 0
        ORDER BY b.BOOK_ID DESC
        OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
    </select>

    <select id="findAllCnt" resultType="int">
        SELECT COUNT(*) FROM BOOK WHERE DELETED = 0
    </select>

    <!-- 단건조회는 삭제여부와 무관하게 항상 실제 행을 그대로 돌려줍니다. 장바구니/주문 검증처럼
         "이 도서가 삭제됐는지" 자체를 확인해야 하는 내부 로직에서 필요하기 때문입니다.
         공개 상세조회 API(BookService.getBook())는 이 결과를 받아 deleted 여부를 직접 확인해서
         삭제된 도서면 별도로 거부 처리합니다. -->
    <select id="findById" parameterType="long" resultMap="BookResultMap">
        SELECT <include refid="bookJoinColumns"/>
        <include refid="bookJoinFrom"/>
        WHERE b.BOOK_ID = #{bookId}
    </select>

    <select id="findByCategory" parameterType="java.util.Map" resultMap="BookResultMap">
        SELECT <include refid="bookJoinColumns"/>
        <include refid="bookJoinFrom"/>
        WHERE b.DELETED = 0
          AND b.CATEGORY LIKE '%' || #{category} || '%'
        ORDER BY b.BOOK_ID DESC
        OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
    </select>

    <select id="findCategoryCnt" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM BOOK
        WHERE DELETED = 0
          AND CATEGORY LIKE '%' || #{category} || '%'
    </select>

    <select id="searchBooks" parameterType="java.util.Map" resultMap="BookResultMap">
        SELECT <include refid="bookJoinColumns"/>
        <include refid="bookJoinFrom"/>
        <where>
            b.DELETED = 0
            <choose>
                <when test="searchType == 'title'">
                    AND UPPER(b.TITLE) LIKE '%' || UPPER(#{keyword}) || '%'
                </when>
                <when test="searchType == 'author'">
                    AND UPPER(b.AUTHOR) LIKE '%' || UPPER(#{keyword}) || '%'
                </when>
                <when test="searchType == 'category'">
                    AND UPPER(b.CATEGORY) LIKE '%' || UPPER(#{keyword}) || '%'
                </when>
                <otherwise>
                    AND UPPER(b.TITLE) LIKE '%' || UPPER(#{keyword}) || '%'
                </otherwise>
            </choose>
        </where>
        ORDER BY b.BOOK_ID DESC
    </select>

    <!-- 삭제된 도서와 같은 제목으로는 다시 등록할 수 있어야 하므로, 활성(DELETED=0) 도서만 검사합니다 -->
    <select id="existsByTitle" parameterType="string" resultType="boolean">
        SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END
        FROM BOOK
        WHERE TITLE = #{title} AND DELETED = 0
    </select>

    <select id="findByAppUserId" parameterType="long" resultMap="BookResultMap">
        SELECT <include refid="bookJoinColumns"/>
        <include refid="bookJoinFrom"/>
        WHERE b.APP_USER_ID = #{appUserId}
          AND b.DELETED = 0
        ORDER BY b.BOOK_ID DESC
    </select>

    <!-- ==================== 등록 / 수정 / 삭제(소프트) ==================== -->

    <insert id="insert" parameterType="java.util.Map">
        <selectKey keyProperty="bookId" resultType="long" order="BEFORE">
            SELECT BOOK_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO BOOK (
            BOOK_ID, TITLE, AUTHOR, PUBLISHER, PUBLISH_DATE, CATEGORY,
            RANKING, REVIEW_COUNT, RATING, DESCRIPTION, PAGES, PRICE,
            REG_DATE, BOOK_COVER, APP_USER_ID, DELETED
        )
        VALUES (
            #{bookId},
            #{title},
            #{author},
            #{publisher},
            #{publishDate, jdbcType=DATE},
            #{category},
            #{ranking, jdbcType=VARCHAR},
            #{reviewCount, jdbcType=INTEGER},
            #{rating, jdbcType=DOUBLE},
            #{description, jdbcType=CLOB},
            #{pages, jdbcType=INTEGER},
            #{price, jdbcType=INTEGER},
            SYSTIMESTAMP,
            #{bookCover, jdbcType=VARCHAR},
            #{appUserId},
            0
        )
    </insert>

    <update id="update" parameterType="java.util.Map">
        UPDATE BOOK
        <set>
            <if test="title != null">TITLE = #{title},</if>
            <if test="author != null">AUTHOR = #{author},</if>
            <if test="publisher != null">PUBLISHER = #{publisher},</if>
            <if test="publishDate != null">PUBLISH_DATE = #{publishDate},</if>
            <if test="category != null">CATEGORY = #{category},</if>
            <if test="ranking != null">RANKING = #{ranking},</if>
            <if test="reviewCount != null">REVIEW_COUNT = #{reviewCount},</if>
            <if test="rating != null">RATING = #{rating},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="pages != null">PAGES = #{pages},</if>
            <if test="price != null">PRICE = #{price},</if>
            <if test="bookCover != null">BOOK_COVER = #{bookCover}</if>
        </set>
        WHERE BOOK_ID = #{bookId}
    </update>

    <!-- 소프트 삭제 - CART_ITEM/ORDER_ITEMS 가 BOOK_ID 를 FK 로 참조하고 있어서, 장바구니에
         담겼거나 한 번이라도 주문된 도서를 실제로 DELETE 하면 FK 제약조건 위반(ORA-02292)이
         발생합니다. 그래서 실제로 지우지 않고 DELETED 플래그만 세워서, 공개 목록/검색/상세
         조회에서만 제외되도록 합니다. -->
    <update id="updateDeleted">
        UPDATE BOOK SET DELETED = #{deleted} WHERE BOOK_ID = #{bookId}
    </update>

    <!-- 테스트/배치 정리용 - 실제 행 삭제. CART_ITEM/ORDER_ITEMS 가 이 도서를 참조하고
         있으면 FK 제약조건 위반으로 실패합니다(의도된 동작입니다). -->
    <delete id="hardDelete" parameterType="long">
        DELETE FROM BOOK WHERE BOOK_ID = #{bookId}
    </delete>

</mapper>
