# project_4/back 로컬 실행용 환경변수 예시 - 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요 (cp .env.example .env)
# .env 는 git 에 올리지 않습니다. 값이 비어 있는 외부 API 는 해당 기능만 "설정 안 됨" 안내가 나오고 앱은 정상 동작합니다.

# ── 필수 ──
JWT_SECRET=32자-이상의-아주-긴-임의-문자열
FRONTEND_BASE_URL=http://localhost:8082          # 카카오페이 결제 후 돌아올 주소 (= 이 백엔드 주소)

# ── 회원가입 이메일 인증 + 결제완료 영수증 메일 (Gmail 앱 비밀번호) ──
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ── 소셜 로그인 (앱 중계) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=                                  # 카카오 REST API 키 (카카오 도서검색·주소검색에도 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH2_REDIRECT_URL=http://localhost:8082/oauth2/app/callback
OAUTH2_SIGNUP_CONFIRM_URL=http://localhost:8082/oauth2/app/signup

# ── 결제 ──
KAKAO_PAY_SECRET_KEY=                             # developers.kakaopay.com 의 Secret Key(dev)

# ── 외부 API ──
KMA_API_KEY=                                      # 공공데이터포털 기상청 단기예보(초단기실황) 일반 인증키(Decoding)
NL_API_KEY=                                       # 국립중앙도서관 오픈API
NAVER_BOOK_CLIENT_ID=                             # 네이버 검색 API (비우면 NAVER_CLIENT_ID 재사용)
NAVER_BOOK_CLIENT_SECRET=
NAVER_OCR_SECRET=                                 # CLOVA OCR General
NAVER_OCR_INVOKE_URL=
COOLSMS_API_KEY=                                  # 결제완료 문자
COOLSMS_API_SECRET=
COOLSMS_FROM=                                     # CoolSMS 에 등록된 발신번호
OPENAI_API_KEY=                                   # 상담 챗봇 AI 보조답변 (없으면 FAQ + 상담원 안내만)

# ── Spring → Django 통계 동기화 ──
DJANGO_SYNC_URL=http://localhost:8000/api/statistics/
STATS_SYNC_TOKEN=대시보드-.env-와-같은-긴-임의-문자열
