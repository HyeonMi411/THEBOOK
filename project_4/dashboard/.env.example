# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 비밀번호가 들어가므로 git 에 올리지 않습니다 (.gitignore 에 이미 제외되어 있음).
# ※ settings.py 의 .env 파서는 따옴표를 벗기지 않으므로, 값에 따옴표를 붙이지 마세요.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# project_4/back(Spring Boot)과 "같은" Oracle DB 접속 정보 (읽기 전용으로만 사용)
ORACLE_DSN=localhost:1521/XE
ORACLE_USER=
ORACLE_PASSWORD=

# Spring Boot ↔ Django 통계 동기화 (project_4/back/.env 의 STATS_SYNC_TOKEN 과 같은 값, 긴 임의 문자열)
STATS_SYNC_TOKEN=
# project_4 백엔드 주소 - 대시보드의 "지금 동기화" 버튼이 호출
SPRING_API_BASE_URL=http://localhost:8082
