<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.thejoa703.mapper.BookMapper">

    <!-- BOOK 테이블 <-> Book 엔티티 매핑 (등록 관리자는 APP_USER_ID 로 참조) -->
    <resultMap id="BookResultMap" type="com.thejoa703.entity.Book">
        <id     property="id"          column="BOOK_ID"/>
        <result property="title"       column="TITLE"/>
        <result property="author"      column="AUTHOR"/>
        <result property="publisher"   column="PUBLISHER"/>
        <result property="publishDate" column="PUBLISH_DATE"/>
        <result property="category"    column="CATEGORY"/>
        <result property="ranking"     column="RANKING"/>
        <result property="reviewCount" column="REVIEW_COUNT"/>
        <result property="rating"      column="RATING"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="pages"       column="PAGES"/>
        <result property="price"       column="PRICE"/>
        <result property="regDate"     column="REG_DATE"/>
        <result property="bookCover"   column="BOOK_COVER"/>
        <!-- ★도서를 등록한 관리자(AppUser) - APP_USER_ID FK -->
        <association property="user" javaType="com.thejoa703.entity.AppUser">
            <id property="id" column="APP_USER_ID"/>
        </association>
    </resultMap>


    <!-- ============================================================ -->
    <!-- 📘 기본 CRUD -->
    <!-- ============================================================ -->

    <!-- 전체 목록조회 (페이징) -->
    <select id="findAll" resultMap="BookResultMap" parameterType="java.util.Map">
        SELECT *
        FROM BOOK
        ORDER BY BOOK_ID DESC
        OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
    </select>

    <!-- 전체 갯수 -->
    <select id="findAllCnt" resultType="int">
        SELECT COUNT(*) FROM BOOK
    </select>

    <!-- 단건 조회 -->
    <select id="findById" parameterType="long" resultMap="BookResultMap">
        SELECT *
        FROM BOOK
        WHERE BOOK_ID = #{bookId}
    </select>

    <!-- 등록 (관리자 전용) -->
    <insert id="insert" parameterType="com.thejoa703.entity.Book">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT BOOK_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO BOOK (
            BOOK_ID, TITLE, AUTHOR, PUBLISHER, PUBLISH_DATE, CATEGORY,
            RANKING, REVIEW_COUNT, RATING, DESCRIPTION, PAGES,
            PRICE, REG_DATE, BOOK_COVER, APP_USER_ID
        )
        VALUES (
            #{id},
            #{title},
            #{author},
            #{publisher},
            #{publishDate},
            #{category},
            #{ranking,     jdbcType=VARCHAR},   <!-- 명시적 타입 지정 -->
            #{reviewCount, jdbcType=INTEGER},
            #{rating,      jdbcType=DOUBLE},
            #{description, jdbcType=CLOB},
            #{pages,       jdbcType=INTEGER},
            #{price,       jdbcType=INTEGER},
            SYSTIMESTAMP,
            #{bookCover,   jdbcType=VARCHAR},
            #{user.id}                            <!-- 등록한 관리자 PK -->
        )
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="com.thejoa703.entity.Book">
        UPDATE BOOK
        <set>
            <if test="title != null">TITLE = #{title},</if>
            <if test="author != null">AUTHOR = #{author},</if>
            <if test="publisher != null">PUBLISHER = #{publisher},</if>
            <if test="publishDate != null">PUBLISH_DATE = #{publishDate},</if>
            <if test="category != null">CATEGORY = #{category},</if>
            <if test="ranking != null">RANKING = #{ranking},</if>
            <if test="reviewCount != null">REVIEW_COUNT = #{reviewCount},</if>
            <if test="rating != null">RATING = #{rating},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="pages != null">PAGES = #{pages},</if>
            <if test="price != null">PRICE = #{price},</if>
            <if test="bookCover != null">BOOK_COVER = #{bookCover}</if>
        </set>
        WHERE BOOK_ID = #{id}
    </update>

    <!-- 삭제 -->
    <delete id="delete" parameterType="long">
        DELETE FROM BOOK
        WHERE BOOK_ID = #{bookId}
    </delete>


    <!-- ============================================================ -->
    <!-- ⭐ 카테고리별 조회 (페이징) -->
    <!-- ============================================================ -->

    <select id="findByCategory" resultMap="BookResultMap" parameterType="java.util.Map">
        SELECT *
        FROM BOOK
        WHERE CATEGORY LIKE '%' || #{category} || '%'
        ORDER BY BOOK_ID DESC
        OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
    </select>

    <select id="findCategoryCnt" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM BOOK
        WHERE CATEGORY LIKE '%' || #{category} || '%'
    </select>


    <!-- ============================================================ -->
    <!-- 🔍 통합검색 (제목/저자/카테고리) + 정렬(rating, reviewCount) + 페이징 -->
    <!-- ============================================================ -->

    <select id="searchBooks" resultMap="BookResultMap" parameterType="java.util.Map">
        SELECT *
        FROM BOOK
        <where>
            <choose>
                <when test="searchType == 'title'">
                    TITLE LIKE '%' || #{keyword} || '%'
                </when>
                <when test="searchType == 'author'">
                    AUTHOR LIKE '%' || #{keyword} || '%'
                </when>
                <when test="searchType == 'category'">
                    CATEGORY LIKE '%' || #{keyword} || '%'
                </when>
            </choose>
        </where>
        <choose>
            <when test="orderBy == 'rating'">ORDER BY RATING DESC</when>
            <when test="orderBy == 'reviewCount'">ORDER BY REVIEW_COUNT DESC</when>
            <otherwise>ORDER BY BOOK_ID DESC</otherwise>
        </choose>
        <if test="start != null and end != null">
            OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
        </if>
    </select>

    <select id="searchBooksCnt" parameterType="java.util.Map" resultType="int">
        SELECT COUNT(*)
        FROM BOOK
        <where>
            <choose>
                <when test="searchType == 'title'">
                    TITLE LIKE '%' || #{keyword} || '%'
                </when>
                <when test="searchType == 'author'">
                    AUTHOR LIKE '%' || #{keyword} || '%'
                </when>
                <when test="searchType == 'category'">
                    CATEGORY LIKE '%' || #{keyword} || '%'
                </when>
            </choose>
        </where>
    </select>


    <!-- ============================================================ -->
    <!-- ⭐ 도서명 중복검사(AJAX) - 정확히 일치하는 제목 갯수 -->
    <!-- ============================================================ -->

    <select id="countByTitle" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM BOOK
        WHERE TITLE = #{title}
    </select>


    <!-- ============================================================ -->
    <!-- ★특정 관리자(AppUser)가 등록한 도서 목록 -->
    <!-- ============================================================ -->

    <select id="findByUserId" parameterType="long" resultMap="BookResultMap">
        SELECT *
        FROM BOOK
        WHERE APP_USER_ID = #{userId}
        ORDER BY BOOK_ID DESC
    </select>

</mapper>
