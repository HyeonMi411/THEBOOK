<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.mapper.BookStockMapper">

    <resultMap id="BookStockResultMap" type="BookStock">
        <id     property="bookId"        column="BOOK_ID"/>
        <result property="stockQuantity" column="STOCK_QUANTITY"/>
        <result property="updatedAt"     column="UPDATED_AT"/>
        <result property="version"       column="VERSION"/>
    </resultMap>

    <select id="findByBookId" parameterType="long" resultMap="BookStockResultMap">
        SELECT * FROM BOOK_STOCK WHERE BOOK_ID = #{bookId}
    </select>

    <!-- 비관적 락 - 이 행을 조회하는 순간부터 다른 트랜잭션이 건드리지 못하게 잠급니다 -->
    <select id="findByBookIdForUpdate" parameterType="long" resultMap="BookStockResultMap">
        SELECT * FROM BOOK_STOCK WHERE BOOK_ID = #{bookId} FOR UPDATE
    </select>

    <insert id="insert" parameterType="BookStock">
        INSERT INTO BOOK_STOCK (BOOK_ID, STOCK_QUANTITY, UPDATED_AT, VERSION)
        VALUES (#{bookId}, #{stockQuantity}, SYSTIMESTAMP, 0)
    </insert>

    <!-- 낙관적 락 재현 - VERSION 이 일치하는 행만 갱신되고, 성공하면 VERSION 을 1 증가시킵니다 -->
    <update id="updateWithVersionCheck" parameterType="BookStock">
        UPDATE BOOK_STOCK
        SET STOCK_QUANTITY = #{stockQuantity},
            UPDATED_AT = SYSTIMESTAMP,
            VERSION = VERSION + 1
        WHERE BOOK_ID = #{bookId} AND VERSION = #{version}
    </update>

    <delete id="deleteByBookId" parameterType="long">
        DELETE FROM BOOK_STOCK WHERE BOOK_ID = #{bookId}
    </delete>

</mapper>
