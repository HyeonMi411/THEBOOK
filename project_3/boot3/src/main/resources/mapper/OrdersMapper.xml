<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.mapper.OrdersMapper">

    <resultMap id="OrdersResultMap" type="Orders">
        <id     property="id"                column="ID"/>
        <result property="totalAmount"       column="TOTAL_AMOUNT"/>
        <result property="orderStatus"       column="ORDER_STATUS"/>
        <result property="tid"               column="TID"/>
        <result property="kakaoResponseJson" column="KAKAO_RESPONSE_JSON"/>
        <result property="createdAt"         column="CREATED_AT"/>
        <result property="approvedAt"        column="APPROVED_AT"/>
        <result property="hiddenByUser"      column="HIDDEN_BY_USER"/>
        <association property="user" javaType="AppUser">
            <id property="id" column="APP_USER_ID"/>
        </association>
    </resultMap>

    <select id="findById" parameterType="long" resultMap="OrdersResultMap">
        SELECT * FROM ORDERS WHERE ID = #{id}
    </select>

    <select id="findByTid" parameterType="string" resultMap="OrdersResultMap">
        SELECT * FROM ORDERS WHERE TID = #{tid}
    </select>

    <!-- hiddenByUser=true(사용자가 숨긴 결제완료/취소/실패 건)는 목록에서 제외합니다 -->
    <select id="findByUserId" parameterType="java.util.Map" resultMap="OrdersResultMap">
        SELECT * FROM ORDERS
        WHERE APP_USER_ID = #{userId} AND HIDDEN_BY_USER = 0
        ORDER BY ID DESC
        OFFSET #{start} ROWS FETCH NEXT #{end} ROWS ONLY
    </select>

    <select id="countByUserId" parameterType="long" resultType="int">
        SELECT COUNT(*) FROM ORDERS WHERE APP_USER_ID = #{userId} AND HIDDEN_BY_USER = 0
    </select>

    <insert id="insert" parameterType="Orders">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT ORDERS_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO ORDERS (ID, APP_USER_ID, TOTAL_AMOUNT, ORDER_STATUS, CREATED_AT, HIDDEN_BY_USER)
        VALUES (#{id}, #{user.id}, #{totalAmount}, #{orderStatus}, SYSTIMESTAMP, 0)
    </insert>

    <!-- 결제준비(tid)/승인(status,approvedAt,kakaoResponseJson)/취소·실패(status)/숨기기(hiddenByUser)
         등 여러 시점에서 부분적으로 갱신되므로, null 이 아닌 항목만 반영합니다. -->
    <update id="update" parameterType="Orders">
        UPDATE ORDERS
        <set>
            <if test="tid != null">TID = #{tid},</if>
            <if test="orderStatus != null">ORDER_STATUS = #{orderStatus},</if>
            <if test="approvedAt != null">APPROVED_AT = #{approvedAt},</if>
            <if test="kakaoResponseJson != null">KAKAO_RESPONSE_JSON = #{kakaoResponseJson, jdbcType=CLOB},</if>
            HIDDEN_BY_USER = #{hiddenByUser}
        </set>
        WHERE ID = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM ORDERS WHERE ID = #{id}
    </delete>

</mapper>
