<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.mapper.HashtagMapper">

    <resultMap id="HashtagResultMap" type="Hashtag">
        <id     property="id"   column="ID"/>
        <result property="name" column="NAME"/>
    </resultMap>

    <select id="findByName" parameterType="string" resultMap="HashtagResultMap">
        SELECT * FROM HASHTAGS WHERE NAME = #{name}
    </select>

    <!-- 해시태그 이름으로 연결된 게시글 목록을 함께 조회 (POST_HASHTAG 조인테이블 경유) -->
    <select id="findPostsByHashtagName" parameterType="string" resultType="Post">
        SELECT p.* FROM POSTS p
        JOIN POST_HASHTAG ph ON p.ID = ph.POST_ID
        JOIN HASHTAGS h ON ph.HASHTAG_ID = h.ID
        WHERE h.NAME = #{name}
    </select>

    <insert id="insert" parameterType="Hashtag">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT HASHTAG_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO HASHTAGS (ID, NAME) VALUES (#{id}, #{name})
    </insert>

    <!-- N:M 조인테이블(POST_HASHTAG)을 거쳐서 특정 게시글의 해시태그 목록을 조회 -->
    <select id="findByPostId" parameterType="long" resultMap="HashtagResultMap">
        SELECT h.* FROM HASHTAGS h
        JOIN POST_HASHTAG ph ON h.ID = ph.HASHTAG_ID
        WHERE ph.POST_ID = #{postId}
    </select>

    <insert id="linkPostHashtag">
        INSERT INTO POST_HASHTAG (POST_ID, HASHTAG_ID) VALUES (#{postId}, #{hashtagId})
    </insert>

    <delete id="deleteLinksByPostId" parameterType="long">
        DELETE FROM POST_HASHTAG WHERE POST_ID = #{postId}
    </delete>

</mapper>
