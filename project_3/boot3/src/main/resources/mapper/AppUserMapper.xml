<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thejoa703.mapper.AppUserMapper">

    <resultMap id="AppUserResultMap" type="AppUser">
        <id     property="id"          column="APP_USER_ID"/>
        <result property="email"       column="EMAIL"/>
        <result property="password"    column="PASSWORD"/>
        <result property="role"        column="ROLE"/>
        <result property="provider"    column="PROVIDER"/>
        <result property="providerId"  column="PROVIDER_ID"/>
        <result property="ufile"       column="UFILE"/>
        <result property="nickname"    column="NICKNAME"/>
        <result property="mobile"      column="MOBILE"/>
        <result property="mbtitype"    column="MBTI_TYPE_ID"/>
        <result property="deleted"     column="DELETED"/>
        <result property="createdAt"   column="CREATED_AT"/>
        <result property="updatedAt"   column="UPDATED_AT"/>
    </resultMap>

    <select id="findById" parameterType="long" resultMap="AppUserResultMap">
        SELECT * FROM APP_USER WHERE APP_USER_ID = #{id}
    </select>

    <select id="findByEmail" parameterType="string" resultMap="AppUserResultMap">
        SELECT * FROM APP_USER WHERE EMAIL = #{email}
    </select>

    <select id="findByEmailAndProvider" resultMap="AppUserResultMap">
        SELECT * FROM APP_USER
        WHERE EMAIL = #{email} AND PROVIDER = #{provider}
    </select>

    <select id="existsByNickname" parameterType="string" resultType="boolean">
        SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END
        FROM APP_USER WHERE NICKNAME = #{nickname}
    </select>

    <select id="existsByEmail" parameterType="string" resultType="boolean">
        SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END
        FROM APP_USER WHERE EMAIL = #{email}
    </select>

    <select id="existsById" parameterType="long" resultType="boolean">
        SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END
        FROM APP_USER WHERE APP_USER_ID = #{id}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM APP_USER
    </select>

    <select id="findRoleById" parameterType="long" resultType="string">
        SELECT ROLE FROM APP_USER WHERE APP_USER_ID = #{id}
    </select>

    <insert id="insert" parameterType="AppUser">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT APPUSER_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO APP_USER (
            APP_USER_ID, EMAIL, PASSWORD, ROLE, PROVIDER, PROVIDER_ID,
            UFILE, NICKNAME, MOBILE, MBTI_TYPE_ID, DELETED, CREATED_AT, UPDATED_AT
        )
        VALUES (
            #{id}, #{email}, #{password}, #{role}, #{provider}, #{providerId},
            #{ufile, jdbcType=VARCHAR}, #{nickname}, #{mobile, jdbcType=VARCHAR},
            #{mbtitype, jdbcType=INTEGER}, #{deleted, jdbcType=NUMERIC},
            SYSTIMESTAMP, SYSTIMESTAMP
        )
    </insert>

    <update id="update" parameterType="AppUser">
        UPDATE APP_USER
        <set>
            <if test="nickname != null">NICKNAME = #{nickname},</if>
            <if test="ufile != null">UFILE = #{ufile},</if>
            <if test="mobile != null">MOBILE = #{mobile},</if>
            <if test="mbtitype != null">MBTI_TYPE_ID = #{mbtitype},</if>
            <if test="role != null">ROLE = #{role},</if>
            <if test="deleted != null">DELETED = #{deleted},</if>
            UPDATED_AT = SYSTIMESTAMP
        </set>
        WHERE APP_USER_ID = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM APP_USER WHERE APP_USER_ID = #{id}
    </delete>

</mapper>
